; Engine configuration file.
config_version=5

[application]

config/name="Project Rise Combat"
config/description="Elden Ring-like combat validation sandbox"
run/main_scene="res://scenes/arena.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Boot="*res://scripts/boot.gd"
CombatBus="*res://scripts/combat_bus.gd"
MoveDB="*res://scripts/move_db.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player_body"
3d_physics/layer_3="enemy_body"
3d_physics/layer_4="player_hit"
3d_physics/layer_5="enemy_hit"
3d_physics/layer_6="player_hurt"
3d_physics/layer_7="enemy_hurt"

[debug]

gdscript/warnings/inference_on_variant=1
gdscript/warnings/unused_parameter=1

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=50.0

[rendering]

renderer/rendering_method="forward_plus"
lights_and_shadows/directional_shadow/size=4096
